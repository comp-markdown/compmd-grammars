{
  "name": "@compmd/lezer",
  "version": "0.1.0",
  "description": "CompMD's grammar for CodeMirror: an @lezer/markdown extension with CompMD's components, params, interpolation, wiki links and math.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/comp-markdown/compmd-grammars.git",
    "directory": "lezer"
  },
  "keywords": ["compmd", "lezer", "codemirror", "markdown"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "generate": "node generate.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "node generate.js --check && vitest run"
  },
  "peerDependencies": {
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.4.0"
  },
  "devDependencies": {
    "@lezer/common": "1.5.5",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
